# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Source Postgres (Ghost / operational DB) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=walmart_ops
PG_USER=walmart_app
PG_PASSWORD=changeme
PG_FORK_DB=walmart_ops_fork   # sandbox clone used for agentic/ad-hoc querying

# --- Databricks workspace ---
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_CATALOG=Walmart
DATABRICKS_INGEST_JOB_ID=123456789012345

# --- AWS S3 (data lake) ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET=walmart-lakehouse-raw
S3_REVIEWS_PREFIX=reviews/

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# --- Agentic / MCP ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx
MCP_LLM_MODEL=claude-haiku-4-5-20251001
